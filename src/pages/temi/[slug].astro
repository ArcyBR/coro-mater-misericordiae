---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const temi = await getCollection('temi');
  return temi.map((tema) => ({
    params: { slug: tema.slug },
    props: { tema },
  }));
}

const { tema } = Astro.props;
const { Content } = await tema.render();
---
<Layout title={tema.data.title} description={tema.data.excerpt}>
  <section class="container">
    <p class="date" style="color: var(--gold); font-size: 0.9rem;">
      {tema.data.date.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
    <h1>{tema.data.title}</h1>
    <p class="lede">{tema.data.excerpt}</p>
    <div class="staff-divider staff-divider--tight" role="presentation"></div>
    <div class="prose"><Content /></div>

    {tema.data.gallery.length > 0 && (
      <div class="gallery">
        {tema.data.gallery.map((foto) => (
          <figure>
            <img src={foto.image} alt={foto.caption ?? tema.data.title} loading="lazy" />
            {foto.caption && <figcaption>{foto.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <p><a href="/temi">&larr; Torna a tutti i temi</a></p>
  </section>
</Layout>
